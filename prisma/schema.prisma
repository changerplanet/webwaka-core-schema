generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["webwaka"]
}

model User {
  @@schema("webwaka")
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  status    UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  externalIdentities ExternalIdentity[]
  tenantMemberships  TenantMembership[]
  partnerUsers       PartnerUser[]
  roleAssignments    RoleAssignment[]
}

model ExternalIdentity {
  @@schema("webwaka")
  id         String @id @default(uuid())
  provider   String
  externalId String

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, externalId])
}

model Tenant {
  @@schema("webwaka")
  id          String @id @default(uuid())
  name        String
  status      TenantStatus @default(ACTIVE)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships TenantMembership[]
  domains     Domain[]
  branding    WhitelabelConfig?
  roleAssignments RoleAssignment[]
}

model TenantMembership {
  @@schema("webwaka")
  id        String @id @default(uuid())

  userId   String
  tenantId String

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, tenantId])
}

model Role {
  @@schema("webwaka")
  id        String @id @default(uuid())
  name      String
  scope     RoleScope

  createdAt DateTime @default(now())

  assignments RoleAssignment[]
}

model Permission {
  @@schema("webwaka")
  id        String @id @default(uuid())
  key       String @unique
  createdAt DateTime @default(now())
}

model RoleAssignment {
  @@schema("webwaka")
  id          String @id @default(uuid())

  userId      String
  roleId      String
  tenantId    String?

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

model Partner {
  @@schema("webwaka")
  id        String @id @default(uuid())
  name      String
  status    PartnerStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  users     PartnerUser[]
  tier      PartnerTier?
}

model PartnerUser {
  @@schema("webwaka")
  id        String @id @default(uuid())

  partnerId String
  userId    String

  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([partnerId, userId])
}

model PartnerTier {
  @@schema("webwaka")
  id        String @id @default(uuid())
  name      String

  partnerId String @unique
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model Domain {
  @@schema("webwaka")
  id        String @id @default(uuid())
  hostname  String @unique

  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model WhitelabelConfig {
  @@schema("webwaka")
  id            String @id @default(uuid())

  tenantId      String @unique
  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  brandName     String
  logoUrl       String?
  primaryColor  String?

  createdAt     DateTime @default(now())
}

model AuditLog {
  @@schema("webwaka")
  id        String @id @default(uuid())
  action    String
  actorId  String?
  metadata Json?

  createdAt DateTime @default(now())
}

model SystemSetting {
  @@schema("webwaka")
  key   String @id
  value Json
}

enum UserStatus {
  @@schema("webwaka")
  ACTIVE
  SUSPENDED
}

enum TenantStatus {
  @@schema("webwaka")
  ACTIVE
  SUSPENDED
}

enum PartnerStatus {
  @@schema("webwaka")
  ACTIVE
  SUSPENDED
}

enum RoleScope {
  @@schema("webwaka")
  PLATFORM
  TENANT
}
